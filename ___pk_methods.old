METHOD 2:

''' CREATE A PICKER BUTTON *GRAPHICS* SLOT
    active_picker > active_scene > buttons
'''
class PK_OT_create_picker_button(Operator):
    bl_idname = "pk.create_picker_button"
    bl_label = ""
    bl_description = "Create Picker Button"

    text : StringProperty(default='', name="Text")

    @classmethod
    def poll(cls, context):
        return context.scene.pickers.active_index != -1

    def execute(self, context):
        create = context.window_manager.ui_data
        pickers = context.scene.pickers
        active_picker = pickers.data[pickers.active_index]
        if active_picker.active_scene == -1:
            return {'FINISHED'}
        active_scene = active_picker.scenes[active_picker.active_scene]
        if active_scene.active_view == -1:
            return {'FINISHED'}
        active_view = active_scene.views[active_scene.active_view]

        ''' CREATE BUTTON '''
        # Check if button is already created
        name = create.button_target_bone.name
        # NOTE: If it's None is sure button_data doesn't exist
        if active_scene.gr_buttons.get(name, None) is None:
            # Create Graphic Button and fill data
            pk_gr_button = active_scene.gr_buttons.add()
            if create.button_text.startswith('Text') and len(active_scene.gr_buttons) != 0:
                create.button_text = "Text." + str(len(active_scene.gr_buttons))
            pk_gr_button.text = create.button_text if self.text == '' else self.text

            # NOTE: Button name MUST BE the bone name
            # As this info is shared between views is part of graphics entity and not data one.
            pk_gr_button.name = create.button_target_bone.name

            ''' CREATE BUTTON DATA '''
            index = len(active_scene.gr_buttons) - 1

        # NOTE: It's not NONE, so graphic exist, check for view buttons
        else:
            ''' CREATE BUTTON DATA '''
            # Search index from gr_buttons
            index = 0
            for gr_b in active_scene.gr_buttons:
                if gr_b.name == name:
                    break
                index += 1
            # Check is button data is already created in active_view
            for b in active_view.buttons:
                if b.index == index:
                    # BUTTON ALREADY EXIST !
                    return {'FINISHED'}
            # Create Button Data
            button = active_view.buttons.add()
            button.index = index
        return {'FINISHED'}


''' Could be useful to save the index of the Button_Graphics
        this way we should know when to add a new button or not
        to active_view by checking the indices of each view button,
        as we don't have same indices here than in active_scene.gr_buttons
    '''


METHOD 1:

''' CREATE A PICKER BUTTON *GRAPHICS* SLOT
    active_picker > active_scene > buttons
'''
class PK_OT_create_picker_button(Operator):
    bl_idname = "pk.create_picker_button"
    bl_label = ""
    bl_description = "Create Picker Button"

    text : StringProperty(default='', name="Text")

    @classmethod
    def poll(cls, context):
        return context.scene.pickers.active_index != -1

    def execute(self, context):
        create = context.window_manager.ui_data
        pickers = context.scene.pickers
        active_picker = pickers.data[pickers.active_index]
        if active_picker.active_scene == -1:
            return {'CANCELLED'}
        active_scene = active_picker.scenes[active_picker.active_scene]
        if active_scene.active_view == -1:
            return {'CANCELLED'}
        active_view = active_scene.views[active_scene.active_view]

        # Check if button is already created
        name = create.button_target_bone.name
        if active_scene.buttons.get(name, None):
            return {'CANCELLED'}

        ''' CREATE BUTTON '''
        pk_button = active_scene.buttons.add()
        if create.button_text.startswith('Text') and len(active_scene.gr_buttons) != 0:
            create.button_text = "Text." + str(len(active_scene.gr_buttons))
        pk_button.style.text = create.button_text if self.text == '' else self.text
        pk_button.name = name # MUST BE the bone name
        pk_button.index = len(active_scene.buttons) - 1
        pk_button.layer_users = 0
        pk_button.active_layer_users = 0
        return {'FINISHED'}